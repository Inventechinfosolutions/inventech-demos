  "scripts": {
    "data": "node scripts/generate-labour-data.mjs && node scripts/generate-welfare-data.mjs && node scripts/generate-factories-data.mjs && node scripts/generate-intelligence-data.mjs && node scripts/generate-gig-data.mjs",
    "check:gig": "vite build --ssr scripts/check-gig-data.ts --outDir /tmp/kbocw-gig-check --emptyOutDir && node /tmp/kbocw-gig-check/check-gig-data.js",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:ksu": "vite build --ssr scripts/check-ksuwssb-data.ts --outDir /tmp/kbocw-ksu-check --emptyOutDir && node /tmp/kbocw-ksu-check/check-ksuwssb-data.js"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
